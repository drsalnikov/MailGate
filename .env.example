# Скопируйте в .env и при необходимости измените значения:
#   cp .env.example .env
# Все переменные опциональны — в docker-compose.yml заданы те же значения по умолчанию.

# --- PostgreSQL ---
POSTGRES_DB=mailgate
POSTGRES_USER=mailgate
POSTGRES_PASSWORD=mailgate
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=mailgate
RABBITMQ_PASSWORD=mailgate
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
# Внешний URL Keycloak (KC_HOSTNAME); issuer токенов должен совпадать с ним
KEYCLOAK_HOSTNAME=http://keycloak.localhost:8180
KEYCLOAK_AUTHORITY=http://keycloak.localhost:8180/realms/mailgate
KEYCLOAK_CLIENT_ID=mailgate-admin
KEYCLOAK_AUDIENCE=mailgate-api
KEYCLOAK_ADMIN_ROLE=mailgate-admin
# true — требовать HTTPS у discovery-документа Keycloak (включить в продакшене)
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# --- MailHog (dev SMTP) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- API ---
API_HTTP_PORT=8080
API_HTTPS_PORT=8443
ASPNETCORE_ENVIRONMENT=Development
# HTTPS выключен по умолчанию (API отвечает только по HTTP на 8080).
# Чтобы включить: раскомментируйте API_HTTPS_ENABLED и положите pfx-сертификат
# в ~/.aspnet/https на хосте (монтируется в контейнер как /https).
#API_HTTPS_ENABLED=true
#KESTREL_CERT_PATH=/https/mailgate.pfx
#KESTREL_CERT_PASSWORD=mailgate_dev
# Разрешённые CORS-origin'ы фронтенда
CORS_ORIGIN_0=http://localhost:8091
CORS_ORIGIN_1=http://localhost:5173

# --- SMTP по умолчанию (переопределяется через админку) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_ADDRESS=noreply@mailgate.local
SMTP_FROM_NAME=MailGate

# --- Frontend ---
FRONTEND_PORT=8091
# URL API, видимый из браузера пользователя
API_BASE_URL=http://localhost:8080

# =====================================================================
# Продакшен в закрытом контуре за внешним nginx (TLS от внутреннего УЦ)
# Пример конфига nginx: config/nginx/mailgate.conf.example
# Подставьте реальные DNS-алиасы и раскомментируйте:
# =====================================================================
#ASPNETCORE_ENVIRONMENT=Production
#KEYCLOAK_HOSTNAME=https://keycloak.example.local
#KEYCLOAK_AUTHORITY=https://keycloak.example.local/realms/mailgate
#KEYCLOAK_REQUIRE_HTTPS_METADATA=true
# Фронтенд и API за nginx на одном имени (same-origin) — базовый URL API тот же хост
#API_BASE_URL=https://mailgate.example.local
# CORS при same-origin не задействуется, origin'ы можно оставить дефолтными
# В Keycloak realm добавьте redirect URI https://mailgate.example.local/*
# и web origin https://mailgate.example.local (см. config/keycloak/README.md)
