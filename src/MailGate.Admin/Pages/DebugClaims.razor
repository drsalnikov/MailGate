@page "/debug/claims"
@attribute [Authorize(Roles = AuthRoles.MailGateAdmin)]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Диагностика claims</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Диагностика OIDC / claims</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_identity is null)
{
    <MudAlert Severity="Severity.Warning">Нет идентичности (не вошли).</MudAlert>
}
else
{
    <MudStack Spacing="2" Class="mb-4">
        <MudText><strong>AuthenticationType:</strong> @_identity.AuthenticationType</MudText>
        <MudText><strong>NameClaimType:</strong> <code>@_identity.NameClaimType</code></MudText>
        <MudText><strong>RoleClaimType:</strong> <code>@_identity.RoleClaimType</code></MudText>
        <MudText><strong>IsAuthenticated:</strong> @_identity.IsAuthenticated</MudText>
        <MudText><strong>IsInRole(&quot;mailgate-admin&quot;):</strong> @_isInAdminRole</MudText>
    </MudStack>

    <MudText Typo="Typo.subtitle1" Class="mb-2">Все claim'ы</MudText>
    <MudTable Items="@_claims" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Тип</MudTh>
            <MudTh>Значение</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Тип"><code>@context.Type</code></MudTd>
            <MudTd DataLabel="Значение" Style="word-break: break-all;">@context.Value</MudTd>
        </RowTemplate>
    </MudTable>

    <MudDivider Class="my-6" />
}

@code {
    private bool _loading = true;
    private ClaimsIdentity? _identity;
    private bool _isInAdminRole;
    private List<ClaimRow> _claims = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _identity = state.User.Identity as ClaimsIdentity;
        _isInAdminRole = state.User.IsInRole("mailgate-admin");
        if (_identity != null)
        {
            _claims = _identity.Claims
                .Select(c => new ClaimRow(c.Type, c.Value))
                .OrderBy(c => c.Type, StringComparer.Ordinal)
                .ToList();
        }

        _loading = false;
    }

    private sealed record ClaimRow(string Type, string Value);
}
