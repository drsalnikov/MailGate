@page "/recipient-groups"
@attribute [Authorize(Roles = AuthRoles.MailGateAdmin)]
@inject RecipientGroupsClient Client
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>MailGate - Группы получателей</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Группы получателей</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Объединяйте получателей в группы для удобного управления адресатами.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreate">Добавить</MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudTextField @bind-Value="_search" Immediate="true" DebounceInterval="400"
                  Placeholder="Поиск по названию или описанию..."
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnDebounceIntervalElapsed="ReloadAsync" />
</MudPaper>

<MudTable Items="_items" Loading="_loading" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>Описание</MudTh>
        <MudTh>Получателей</MudTh>
        <MudTh>Состав</MudTh>
        <MudTh>Обновлена</MudTh>
        <MudTh Style="width: 120px;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@(context.Description ?? "—")</MudTd>
        <MudTd>@context.RecipientCount</MudTd>
        <MudTd>
            @if (context.Recipients.Count == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Нет получателей</MudText>
            }
            else
            {
                <MudChipSet T="Guid" ReadOnly="true">
                    @foreach (var recipient in context.Recipients.Take(5))
                    {
                        <MudChip T="Guid" Value="@recipient.Id" Text="@recipient.FullName" Size="Size.Small" />
                    }
                </MudChipSet>
                @if (context.Recipients.Count > 5)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        ещё @(context.Recipients.Count - 5)
                    </MudText>
                }
            }
        </MudTd>
        <MudTd>@(context.UpdatedAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="() => OpenEdit(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="() => DeleteAsync(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Групп пока нет.</NoRecordsContent>
</MudTable>

<MudPagination Class="mt-4" Count="@_totalPages" SelectedChanged="OnPageChanged" Selected="_page" />

@code {
    private string? _search;
    private int _page = 1;
    private const int PageSize = 50;
    private int _totalPages = 1;
    private bool _loading;
    private List<RecipientGroupDto> _items = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var result = await Client.ListAsync(_search, _page, PageSize);
            _items = result.Items.ToList();
            _totalPages = Math.Max(1, result.TotalPages);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private void OpenCreate()
        => Nav.NavigateTo("recipient-groups/new");

    private void OpenEdit(RecipientGroupDto group)
        => Nav.NavigateTo($"recipient-groups/{group.Id}/edit");

    private async Task DeleteAsync(RecipientGroupDto group)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Удалить группу",
            $"Удалить группу «{group.Name}»? Получатели удалены не будут.",
            yesText: "Удалить", cancelText: "Отмена");

        if (confirm != true) return;

        try
        {
            await Client.DeleteAsync(group.Id);
            Snackbar.Add("Группа удалена", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не удалось удалить: {ex.Message}", Severity.Error);
        }
    }
}
