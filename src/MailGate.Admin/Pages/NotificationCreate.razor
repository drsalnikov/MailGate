@page "/notifications/new"
@attribute [Authorize(Roles = AuthRoles.MailGateAdmin)]
@inject NotificationsClient NotificationsClient
@inject RecipientsClient RecipientsClient
@inject RecipientGroupsClient RecipientGroupsClient
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>MailGate — Новая рассылка</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Новая рассылка</MudText>

<MudPaper Class="pa-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect T="ChannelType" Label="Канал" @bind-Value="_channel">
                <MudSelectItem Value="ChannelType.Smtp">SMTP</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="NotificationPriority" Label="Приоритет" @bind-Value="_priority">
                <MudSelectItem Value="NotificationPriority.Low">Low</MudSelectItem>
                <MudSelectItem Value="NotificationPriority.Normal">Normal</MudSelectItem>
                <MudSelectItem Value="NotificationPriority.High">High</MudSelectItem>
                <MudSelectItem Value="NotificationPriority.Critical">Critical</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudAutocomplete T="RecipientDto" Label="Получатели из адресной книги"
                             SearchFunc="SearchRecipients"
                             ToStringFunc="@(r => r is null ? string.Empty : $"{r.FullName} <{r.Email}>")"
                             ValueChanged="OnRecipientPicked"
                             ResetValueOnEmptyText="true" CoerceText="false" />
            <MudChipSet T="Guid" Class="mt-2">
                @foreach (var r in _selectedRecipients)
                {
                    <MudChip T="Guid" Value="@r.Id" Text="@($"{r.FullName} <{r.Email}>")"
                             OnClose="() => RemoveRecipient(r.Id)" />
                }
            </MudChipSet>
        </MudItem>

        <MudItem xs="12">
            <MudAutocomplete T="RecipientGroupDto" Label="Группы получателей"
                             SearchFunc="SearchRecipientGroups"
                             ToStringFunc="@(g => g is null ? string.Empty : $"{g.Name} ({g.RecipientCount})")"
                             ValueChanged="OnRecipientGroupPicked"
                             ResetValueOnEmptyText="true" CoerceText="false" />
            <MudChipSet T="Guid" Class="mt-2">
                @foreach (var group in _selectedRecipientGroups)
                {
                    <MudChip T="Guid" Value="@group.Id" Text="@($"{group.Name} ({group.RecipientCount})")"
                             OnClose="() => RemoveRecipientGroup(group.Id)" />
                }
            </MudChipSet>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_adHocEmailsText" Label="Дополнительные email (через запятую или новые строки)"
                          Lines="2" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_subject" Label="Тема" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="BodyFormat" Label="Формат тела" @bind-Value="_bodyFormat">
                <MudSelectItem Value="BodyFormat.PlainText">Plain text</MudSelectItem>
                <MudSelectItem Value="BodyFormat.Html">HTML</MudSelectItem>
                <MudSelectItem Value="BodyFormat.Markdown">Markdown</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_body" Label="Тело" Lines="10" Required="true" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SubmitAsync" Disabled="_sending">
            @if (_sending) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> } else { @("Отправить") }
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("notifications"))">Отмена</MudButton>
    </MudStack>
</MudPaper>

@code {
    private ChannelType _channel = ChannelType.Smtp;
    private NotificationPriority _priority = NotificationPriority.Normal;
    private BodyFormat _bodyFormat = BodyFormat.PlainText;
    private string? _subject;
    private string _body = string.Empty;
    private string? _adHocEmailsText;
    private bool _sending;

    private readonly List<RecipientDto> _selectedRecipients = [];
    private readonly List<RecipientGroupDto> _selectedRecipientGroups = [];

    private async Task<IEnumerable<RecipientDto>> SearchRecipients(string? value, CancellationToken ct)
    {
        var result = await RecipientsClient.ListAsync(value, 1, 20, ct);
        return result.Items
            .Where(r => !_selectedRecipients.Any(s => s.Id == r.Id))
            .ToList();
    }

    private void OnRecipientPicked(RecipientDto? recipient)
    {
        if (recipient is null) return;
        if (_selectedRecipients.Any(r => r.Id == recipient.Id)) return;
        _selectedRecipients.Add(recipient);
    }

    private void RemoveRecipient(Guid id)
    {
        var match = _selectedRecipients.FirstOrDefault(r => r.Id == id);
        if (match is not null)
            _selectedRecipients.Remove(match);
    }

    private async Task<IEnumerable<RecipientGroupDto>> SearchRecipientGroups(string? value, CancellationToken ct)
    {
        var result = await RecipientGroupsClient.ListAsync(value, 1, 20, ct);
        return result.Items
            .Where(g => !_selectedRecipientGroups.Any(s => s.Id == g.Id))
            .ToList();
    }

    private void OnRecipientGroupPicked(RecipientGroupDto? group)
    {
        if (group is null) return;
        if (_selectedRecipientGroups.Any(g => g.Id == group.Id)) return;
        _selectedRecipientGroups.Add(group);
    }

    private void RemoveRecipientGroup(Guid id)
    {
        var match = _selectedRecipientGroups.FirstOrDefault(g => g.Id == id);
        if (match is not null)
            _selectedRecipientGroups.Remove(match);
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_body))
        {
            Snackbar.Add("Заполните тело сообщения", Severity.Warning);
            return;
        }

        var adHoc = (_adHocEmailsText ?? string.Empty)
            .Split([',', ';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (_selectedRecipients.Count == 0 && _selectedRecipientGroups.Count == 0 && adHoc.Count == 0)
        {
            Snackbar.Add("Укажите получателей", Severity.Warning);
            return;
        }

        _sending = true;
        try
        {
            var dto = new SendNotificationFromAdminDto
            {
                Channel = _channel,
                Priority = _priority,
                BodyFormat = _bodyFormat,
                Subject = _subject,
                Body = _body,
                RecipientIds = _selectedRecipients.Select(r => r.Id).ToList(),
                RecipientGroupIds = _selectedRecipientGroups.Select(g => g.Id).ToList(),
                AdHocEmails = adHoc
            };

            var messageId = await NotificationsClient.SendAsync(dto);
            Snackbar.Add($"Рассылка поставлена в очередь: {messageId}", Severity.Success);
            Nav.NavigateTo("notifications");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally { _sending = false; }
    }
}
