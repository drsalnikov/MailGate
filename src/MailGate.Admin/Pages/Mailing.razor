@page "/mailing"
@attribute [Authorize(Roles = AuthRoles.MailGateAdmin)]

<PageTitle>MailGate - Рассылка</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Рассылка</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Раздел объединяет работу с рассылками: просмотр истории отправок, создание новой рассылки и управление адресной книгой получателей.
        </MudAlert>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudCard Outlined="true" Class="h-100">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Системы</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Справочник систем, на которые подписываются получатели для адресной доставки уведомлений.
                </MudText>
                <MudButton Href="systems" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Открыть системы
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudCard Outlined="true" Class="h-100">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Группы получателей</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Объединение получателей в группы для удобного управления адресатами.
                </MudText>
                <MudButton Href="recipient-groups" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Открыть группы
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudCard Outlined="true" Class="h-100">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Outbox" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Рассылки</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Журнал отправок с фильтрами, статусами, деталями сообщений и повторной отправкой при необходимости.
                </MudText>
                <MudButton Href="notifications" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Открыть рассылки
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudCard Outlined="true" Class="h-100">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Новая рассылка</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Ручная отправка уведомления выбранным получателям или на произвольные email-адреса.
                </MudText>
                <MudButton Href="notifications/new" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Создать рассылку
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6" lg="3">
        <MudCard Outlined="true" Class="h-100">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Получатели</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Адресная книга для хранения получателей, поиска по имени и email, добавления и редактирования записей.
                </MudText>
                <MudButton Href="recipients" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Открыть получателей
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
